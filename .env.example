SUPABASE_PROJECT_ID=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres?sslmode=require
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Configure these three values in the server/deployment environment, not in the GitHub repository.
# Keep them server-only; never prefix with VITE_. ADMIN_PANEL_PASSWORD must have at least 8 characters.
# For local development, use a private .env file (never commit it).
ADMIN_PANEL_PATH_SECRET=
ADMIN_PANEL_PASSWORD=
ADMIN_PANEL_PIN=
